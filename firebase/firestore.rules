rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
//  BÜBÜ — Reglas de seguridad de Cloud Firestore (proyecto bubi-246b8)
//
//  Principios:
//   • Todo lo que no está permitido aquí, está PROHIBIDO (deny by default).
//   • Solo el catálogo (categorías y zonas) es de lectura pública; no tiene
//     datos personales. Todo lo demás exige sesión iniciada.
//   • Nadie se puede dar permisos de admin: la colección `admins` solo se
//     escribe desde la consola de Firebase (que no pasa por estas reglas).
//   • Un proveedor no se puede aprobar solo; solo un admin cambia su estado.
//   • Un proveedor no aprobado no publica servicios ni recibe pedidos.
//   • Los pedidos solo los ven el cliente, el proveedor y los admins, y su
//     estado solo avanza por las transiciones permitidas.
//   • `priceEstimate` / `priceFrom` son solo informativos.
//     `finalPrice` (lo que el socio cobró) solo sirve para calcular la comisión.
//   • Pago con tarjeta (Stripe): solo el SERVIDOR marca un pedido como
//     pagado ('paid'), después de confirmar el pago con Stripe.
//
//  La tabla de transiciones de pedidos está duplicada en
//  mobile/src/constants/orderStatus.js. Si cambias una, cambia la otra.
// ═══════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ───────────── Utilidades ─────────────
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Dueño de BÜBÜ (role 'superadmin'). Los colaboradores (role 'staff') son admins
    // normales: revisan, aprueban, suspenden y leen chats, pero NO tocan dinero, la
    // configuración de comisiones ni la lista de colaboradores.
    function isSuperAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'superadmin';
    }

    function isActiveUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    function providerData(id) {
      return get(/databases/$(database)/documents/providers/$(id)).data;
    }

    // Aprobado y SIN bloqueo por adeudo (debtBlocks/{uid} lo crea o borra solo el servidor,
    // cuando el saldo del socio pasa el límite de adeudo). Bloqueado: no ve ni recibe
    // pedidos nuevos, pero sí puede terminar los que ya tiene.
    function isApprovedProviderId(id) {
      return exists(/databases/$(database)/documents/providers/$(id))
        && providerData(id).status == 'approved'
        && !exists(/databases/$(database)/documents/debtBlocks/$(id));
    }

    function isApprovedProvider() {
      return signedIn() && isApprovedProviderId(request.auth.uid);
    }

    function zoneActive(zoneId) {
      return zoneId is string
        && exists(/databases/$(database)/documents/zones/$(zoneId))
        && get(/databases/$(database)/documents/zones/$(zoneId)).data.active == true;
    }

    function categoryActive(categoryId) {
      return categoryId is string
        && exists(/databases/$(database)/documents/categories/$(categoryId))
        && get(/databases/$(database)/documents/categories/$(categoryId)).data.active == true;
    }

    function changedKeys() { return request.resource.data.diff(resource.data).affectedKeys(); }

    function isStr(v, minLen, maxLen) { return v is string && v.size() >= minLen && v.size() <= maxLen; }
    function optStr(d, key, maxLen) { return !(key in d) || isStr(d[key], 0, maxLen); }
    // Mapa: punto (lat/lng) y área de servicio (punto + radio en km).
    function validGeo(m) {
      return m is map && m.keys().hasAll(['lat', 'lng'])
        && m.lat is number && m.lat >= -90 && m.lat <= 90
        && m.lng is number && m.lng >= -180 && m.lng <= 180;
    }
    function validArea(m) {
      return validGeo(m) && m.keys().hasOnly(['lat', 'lng', 'radiusKm'])
        && m.radiusKm is number && m.radiusKm >= 0.5 && m.radiusKm <= 50;
    }
    function isPrice(v) { return v is number && v >= 0 && v <= 100000; }
    function isModeList(v) {
      return v is list && v.size() >= 1 && v.size() <= 2 && v.hasOnly(['dropoff', 'pickup_delivery']);
    }
    function isIdList(v, maxItems) {
      return v is list && v.size() >= 1 && v.size() <= maxItems;
    }
    function updatedNowIfPresent(d) { return !('updatedAt' in d) || d.updatedAt == request.time; }
    // En actualizaciones: si cambia updatedAt, debe ser la hora del servidor.
    function updatedNowIfChanged() {
      return !('updatedAt' in changedKeys()) || request.resource.data.updatedAt == request.time;
    }

    // ───────────── Administradores ─────────────
    // Se crean A MANO en la consola: admins/{UID} con { role: 'superadmin' }.
    match /admins/{adminId} {
      allow get: if signedIn() && (me() == adminId || isAdmin());
      allow list: if isAdmin();
      // El superadmin agrega colaboradores (solo 'staff', con cuenta de BÜBÜ existente)
      // y los quita. Nadie se da permisos a sí mismo ni crea otro superadmin.
      allow create: if isSuperAdmin() && adminId != me()
        && exists(/databases/$(database)/documents/users/$(adminId))
        && request.resource.data.keys().hasOnly(['role', 'email', 'name', 'createdAt', 'createdBy'])
        && request.resource.data.role == 'staff'
        && optStr(request.resource.data, 'email', 120)
        && optStr(request.resource.data, 'name', 80)
        && request.resource.data.createdBy == me()
        && request.resource.data.createdAt == request.time;
      allow delete: if isSuperAdmin() && adminId != me() && resource.data.role == 'staff';
      allow update: if false;
    }

    // ───────────── Usuarios ─────────────
    function validUserCreate(d) {
      return d.keys().hasOnly(['displayName', 'email', 'phone', 'colonia', 'zoneId', 'activeMode', 'status', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['displayName', 'email', 'activeMode', 'status', 'createdAt'])
        && isStr(d.displayName, 1, 80)
        && request.auth.token.email is string
        && d.email == request.auth.token.email.lower()
        && optStr(d, 'phone', 20)
        && optStr(d, 'colonia', 80)
        && optStr(d, 'zoneId', 60)
        && d.activeMode == 'client'
        && d.status == 'active'
        && d.createdAt == request.time
        && updatedNowIfPresent(d);
    }

    function validSelfUserUpdate() {
      let d = request.resource.data;
      return resource.data.status == 'active'
        && changedKeys().hasOnly(['displayName', 'phone', 'colonia', 'zoneId', 'activeMode', 'updatedAt'])
        && isStr(d.displayName, 1, 80)
        && optStr(d, 'phone', 20)
        && optStr(d, 'colonia', 80)
        && optStr(d, 'zoneId', 60)
        && d.activeMode in ['client', 'provider']
        && updatedNowIfChanged();
    }

    function validAdminUserUpdate() {
      return changedKeys().hasOnly(['status', 'statusNote', 'updatedAt'])
        && request.resource.data.status in ['active', 'review', 'suspended']
        && optStr(request.resource.data, 'statusNote', 300);
    }

    match /users/{userId} {
      allow get: if signedIn() && (me() == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn() && me() == userId && validUserCreate(request.resource.data);
      allow update: if signedIn() && (
        (me() == userId && validSelfUserUpdate())
        || (isAdmin() && validAdminUserUpdate())
      );
      allow delete: if false;
    }

    // ───────────── Proveedores (id del documento = UID) ─────────────
    function validProviderFields(d) {
      return isStr(d.businessName, 2, 80)
        // Negocio establecido o persona que trabaja desde casa.
        && (!('providerType' in d) || d.providerType in ['business', 'home'])
        && optStr(d, 'description', 500)
        && isIdList(d.categoryIds, 10)
        && isIdList(d.zoneIds, 5)
        && isModeList(d.fulfillmentModes);
    }

    function validProviderCreate(d) {
      return d.keys().hasOnly(['businessName', 'description', 'providerType', 'categoryIds', 'zoneIds', 'fulfillmentModes', 'status', 'reviewNote', 'createdAt', 'updatedAt'])
        && validProviderFields(d)
        && categoryActive(d.categoryIds[0])
        && zoneActive(d.zoneIds[0])
        && d.status == 'pending'
        && (!('reviewNote' in d) || d.reviewNote == '')
        && d.createdAt == request.time
        && updatedNowIfPresent(d);
    }

    function validProviderSelfUpdate() {
      let d = request.resource.data;
      let old = resource.data;
      return old.status != 'suspended'
        && changedKeys().hasOnly(['businessName', 'description', 'providerType', 'categoryIds', 'zoneIds', 'fulfillmentModes', 'status', 'isAvailable', 'lastSeenAt', 'serviceArea', 'updatedAt'])
        && validProviderFields(d)
        // Zona de servicio en el mapa (punto aproximado + radio).
        && (!('serviceArea' in changedKeys()) || validArea(d.serviceArea))
        // El estado no cambia, salvo reenviar una solicitud rechazada.
        && (d.status == old.status || (old.status == 'rejected' && d.status == 'pending'))
        // Disponibilidad ("Estoy disponible") y última conexión.
        && (!('isAvailable' in d) || d.isAvailable is bool)
        && (!('lastSeenAt' in changedKeys()) || d.lastSeenAt == request.time)
        && updatedNowIfChanged();
    }

    function validProviderAdminUpdate() {
      let d = request.resource.data;
      return changedKeys().hasOnly(['status', 'reviewNote', 'reviewedAt', 'reviewedBy', 'updatedAt'])
        && d.status in ['pending', 'approved', 'rejected', 'suspended']
        && optStr(d, 'reviewNote', 300)
        && (!('reviewedBy' in changedKeys()) || d.reviewedBy == me());
    }

    match /providers/{providerId} {
      // Perfil aprobado: visible para usuarios con sesión. Pendiente/rechazado: solo dueño y admin.
      allow get: if signedIn() && (me() == providerId || resource.data.status == 'approved' || isAdmin());
      allow list: if signedIn() && (resource.data.status == 'approved' || isAdmin());
      allow create: if isActiveUser() && me() == providerId && validProviderCreate(request.resource.data);
      allow update: if signedIn() && (
        (me() == providerId && isActiveUser() && validProviderSelfUpdate())
        || (isAdmin() && validProviderAdminUpdate())
      );
      allow delete: if false;
    }

    // ───────────── Catálogo: categorías y zonas (lectura pública) ─────────────
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && isStr(request.resource.data.name, 2, 60)
        && request.resource.data.active is bool
        && optStr(request.resource.data, 'icon', 16)
        && optStr(request.resource.data, 'description', 200);
      allow delete: if isAdmin();
    }

    match /zones/{zoneId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && isStr(request.resource.data.name, 2, 80)
        && request.resource.data.active is bool
        && (!('colonias' in request.resource.data) || (request.resource.data.colonias is list && request.resource.data.colonias.size() <= 300))
        // Cobertura de la zona dibujada en el mapa del panel (centro + radio).
        && (!('coverage' in request.resource.data) || validArea(request.resource.data.coverage));
      allow delete: if isAdmin();
    }

    // ───────────── Servicios publicados por proveedores ─────────────
    function validService(d) {
      return d.keys().hasOnly(['providerId', 'providerName', 'categoryId', 'zoneIds', 'title', 'description', 'priceFrom', 'priceUnit', 'fulfillmentModes', 'active', 'createdAt', 'updatedAt'])
        && d.providerId == me()
        && isStr(d.providerName, 1, 80)
        && isStr(d.title, 3, 80)
        && optStr(d, 'description', 500)
        && isPrice(d.priceFrom)
        && isStr(d.priceUnit, 1, 30)
        && isIdList(d.zoneIds, 5)
        && isModeList(d.fulfillmentModes)
        && d.active is bool
        && d.categoryId in providerData(me()).categoryIds
        && updatedNowIfPresent(d);
    }

    match /services/{serviceId} {
      allow get, list: if signedIn() && (resource.data.active == true || resource.data.providerId == me() || isAdmin());
      allow create: if isApprovedProvider()
        && validService(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && (
        (resource.data.providerId == me() && isApprovedProvider()
          && validService(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt)
        || (isAdmin() && changedKeys().hasOnly(['active', 'updatedAt']))
      );
      allow delete: if signedIn() && (resource.data.providerId == me() || isAdmin());
    }

    // ───────────── Solicitudes abiertas ("no encuentro lo que busco") ─────────────
    // Un pedido publicado NO lleva nombre, teléfono ni dirección del cliente:
    // solo colonia y qué necesita. Los datos de contacto se comparten únicamente
    // con el proveedor elegido, dentro del pedido (orders).
    function validRequestCreate(d) {
      return d.keys().hasOnly(['customerId', 'customerName', 'categoryId', 'zoneId', 'colonia', 'approxGeo', 'description', 'services', 'quantityText', 'whenText', 'fulfillmentMode', 'preferredDate', 'expiresAt', 'status', 'createdAt', 'updatedAt'])
        // Ubicación APROXIMADA del cliente (~1 km) para saber qué socios le quedan cerca.
        && (!('approxGeo' in d) || (validGeo(d.approxGeo) && d.approxGeo.keys().hasOnly(['lat', 'lng'])))
        && d.customerId == me()
        && optStr(d, 'customerName', 80)
        && categoryActive(d.categoryId)
        && zoneActive(d.zoneId)
        && isStr(d.colonia, 1, 80)
        && optStr(d, 'description', 500)
        && (!('services' in d) || (d.services is list && d.services.size() <= 8))
        && (isStr(d.get('description', ''), 3, 500) || (d.get('services', []).size() > 0))
        && optStr(d, 'quantityText', 40)
        && optStr(d, 'whenText', 40)
        && d.fulfillmentMode in ['dropoff', 'pickup_delivery']
        && (!('preferredDate' in d) || d.preferredDate is timestamp)
        // Recibe ofertas durante ~30 minutos (margen por diferencia de reloj del teléfono).
        && d.expiresAt is timestamp
        && d.expiresAt > request.time + duration.value(20, 'm')
        && d.expiresAt < request.time + duration.value(40, 'm')
        && d.status == 'open'
        && d.createdAt == request.time
        && updatedNowIfPresent(d);
    }

    function providerCanSeeRequest(r) {
      // Los proveedores aprobados de esa categoría y zona ven los pedidos
      // (abiertos y pasados) para ofertar y para ver "los que se perdieron".
      // Ojo: en consultas, categoryId y zoneId deben filtrarse con ==.
      return isApprovedProvider()
        && r.categoryId in providerData(me()).categoryIds
        && r.zoneId in providerData(me()).zoneIds;
    }

    match /requests/{requestId} {
      allow get, list: if signedIn() && (resource.data.customerId == me() || providerCanSeeRequest(resource.data) || isAdmin());
      allow create: if isActiveUser() && validRequestCreate(request.resource.data);
      allow update: if signedIn() && (
        // El cliente cancela o cierra su pedido abierto…
        (resource.data.customerId == me()
          && resource.data.status == 'open'
          && changedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status in ['closed', 'cancelled'])
        // …o elige una oferta que existe (queda "assigned").
        || (resource.data.customerId == me()
          && resource.data.status == 'open'
          && changedKeys().hasOnly(['status', 'chosenProviderId', 'orderId', 'updatedAt'])
          && request.resource.data.status == 'assigned'
          && request.resource.data.chosenProviderId is string
          && isStr(request.resource.data.orderId, 1, 128)
          && exists(/databases/$(database)/documents/requests/$(requestId)/offers/$(request.resource.data.chosenProviderId))
          // El pedido (orders) debe crearse en el MISMO paso, ligado a esta solicitud y a ese proveedor.
          && existsAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId))
          && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.requestId == requestId
          && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.providerId == request.resource.data.chosenProviderId)
        || (isAdmin() && changedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status in ['open', 'closed', 'cancelled'])
      );
      allow delete: if false;

      // Ofertas de proveedores a una solicitud (id = UID del proveedor).
      function parentRequest() {
        return get(/databases/$(database)/documents/requests/$(requestId)).data;
      }

      match /offers/{offerProviderId} {
        allow get: if signedIn() && (offerProviderId == me() || parentRequest().customerId == me() || isAdmin());
        allow list: if signedIn() && (parentRequest().customerId == me() || isAdmin());
        allow create: if isApprovedProvider()
          && offerProviderId == me()
          // Solo proveedores con "Estoy disponible" activado…
          && providerData(me()).get('isAvailable', false) == true
          // …de la categoría y zona del pedido, y que ofrezcan la modalidad pedida.
          && parentRequest().categoryId in providerData(me()).categoryIds
          && parentRequest().zoneId in providerData(me()).zoneIds
          && parentRequest().fulfillmentMode in providerData(me()).fulfillmentModes
          && parentRequest().status == 'open'
          && (!('expiresAt' in parentRequest()) || request.time < parentRequest().expiresAt)
          && parentRequest().customerId != me()
          && request.resource.data.keys().hasOnly(['providerId', 'providerName', 'providerType', 'kind', 'message', 'priceFrom', 'pickupText', 'readyText', 'providerPhone', 'createdAt', 'updatedAt'])
          // kind: 'accept' = acepta el horario del cliente; 'offer' = propone precio/horario.
          && (!('kind' in request.resource.data) || request.resource.data.kind in ['accept', 'offer'])
          && (!('providerType' in request.resource.data) || request.resource.data.providerType in ['business', 'home'])
          && request.resource.data.providerId == me()
          && isStr(request.resource.data.providerName, 1, 80)
          && optStr(request.resource.data, 'message', 500)
          && optStr(request.resource.data, 'pickupText', 60)
          && optStr(request.resource.data, 'readyText', 60)
          && optStr(request.resource.data, 'providerPhone', 20)
          && (!('priceFrom' in request.resource.data) || isPrice(request.resource.data.priceFrom))
          && request.resource.data.createdAt == request.time;
        allow update: if signedIn() && offerProviderId == me()
          && parentRequest().status == 'open'
          && (!('expiresAt' in parentRequest()) || request.time < parentRequest().expiresAt)
          && changedKeys().hasOnly(['message', 'priceFrom', 'pickupText', 'readyText', 'providerPhone', 'updatedAt'])
          && optStr(request.resource.data, 'message', 500)
          && optStr(request.resource.data, 'pickupText', 60)
          && optStr(request.resource.data, 'readyText', 60)
          && optStr(request.resource.data, 'providerPhone', 20)
          && (!('priceFrom' in request.resource.data) || isPrice(request.resource.data.priceFrom));
        allow delete: if signedIn() && (offerProviderId == me() || isAdmin());
      }
    }

    // ───────────── Comisión de BÜBÜ ─────────────
    // Por cada pedido entregado se le descuenta al socio: total × % de comisión,
    // más IVA sobre esa comisión. Lo fija el admin en config/commission; si todavía
    // no existe: 30 % de comisión y 16 % de IVA.
    function validCommissionPct(v) { return v is number && v >= 0 && v <= 40; }
    function validIvaPct(v) { return v is number && v >= 0 && v <= 16; }
    function commissionConfig() { return /databases/$(database)/documents/config/commission; }
    // ¿Ya está activo el servidor (plan Blaze: Storage + Cloud Functions)?
    // Lo prende el admin en Pagos a socios. Apagado: no se exigen fotos ni PIN.
    function serverOn() {
      return exists(commissionConfig()) && get(commissionConfig()).data.get('serverOn', false) == true;
    }
    function currentCommissionPct() {
      return exists(commissionConfig()) ? get(commissionConfig()).data.pct : 30;
    }
    function currentIvaPct() {
      return exists(commissionConfig()) ? get(commissionConfig()).data.get('ivaPct', 16) : 16;
    }
    // Cuota de servicio: la paga TODO cliente (tarjeta o efectivo); es 100 % de BÜBÜ.
    function currentServiceFee() {
      return exists(commissionConfig()) ? get(commissionConfig()).data.get('serviceFee', 10) : 10;
    }

    // ───────────── Pedidos y reservas ─────────────
    // Reserva = pedido con `scheduledAt` (fecha acordada). Mismo flujo de estados.
    function providerNext() {
      return {
        'requested': ['accepted', 'rejected'],
        'accepted': ['in_progress', 'cancelled'],
        'in_progress': ['ready'],
        'ready': ['delivered']
      };
    }
    function customerNext() {
      return {
        'requested': ['cancelled'],
        'accepted': ['cancelled']
      };
    }
    function allStatuses() {
      return ['requested', 'accepted', 'rejected', 'in_progress', 'ready', 'delivered', 'cancelled', 'disputed'];
    }

    function validOrderCreate(d, orderId) {
      return d.keys().hasOnly(['customerId', 'providerId', 'serviceId', 'requestId', 'categoryId', 'zoneId', 'customerName', 'providerName', 'details', 'fulfillmentMode', 'colonia', 'address', 'customerPhone', 'providerPhone', 'agreedPickup', 'agreedReady', 'scheduledAt', 'whenText', 'priceEstimate', 'status', 'createdAt', 'updatedAt', 'statusChangedAt'])
        && d.keys().hasAll(['customerId', 'providerId', 'categoryId', 'zoneId', 'customerName', 'details', 'fulfillmentMode', 'colonia', 'status', 'createdAt'])
        && d.customerId == me()
        && d.providerId is string
        && d.providerId != me()
        && isApprovedProviderId(d.providerId)
        && d.categoryId in providerData(d.providerId).categoryIds
        && d.zoneId in providerData(d.providerId).zoneIds
        && d.fulfillmentMode in providerData(d.providerId).fulfillmentModes
        && zoneActive(d.zoneId)
        && isStr(d.customerName, 1, 80)
        && optStr(d, 'providerName', 80)
        && isStr(d.details, 3, 1000)
        && isStr(d.colonia, 1, 80)
        // Domicilio obligatorio solo si el proveedor pasa a recoger.
        && (d.fulfillmentMode == 'pickup_delivery' ? isStr(d.address, 5, 200) : optStr(d, 'address', 200))
        && optStr(d, 'customerPhone', 20)
        && optStr(d, 'providerPhone', 20)
        && optStr(d, 'agreedPickup', 60)
        && optStr(d, 'agreedReady', 60)
        && optStr(d, 'whenText', 40)
        && (!('scheduledAt' in d) || (d.scheduledAt is timestamp && d.scheduledAt > request.time))
        && (!('priceEstimate' in d) || isPrice(d.priceEstimate))
        && optStr(d, 'requestId', 128)
        && (!('serviceId' in d) || (
              exists(/databases/$(database)/documents/services/$(d.serviceId))
              && get(/databases/$(database)/documents/services/$(d.serviceId)).data.providerId == d.providerId
              && get(/databases/$(database)/documents/services/$(d.serviceId)).data.active == true))
        // Reserva directa: nace "requested" y el proveedor acepta o rechaza.
        // Desde una oferta elegida: nace "accepted" (el proveedor ya se ofreció).
        && (d.status == 'requested' || (d.status == 'accepted' && orderFromMyOffer(d, orderId)))
        && d.createdAt == request.time
        && updatedNowIfPresent(d);
    }

    // Pedido nacido de una oferta: la solicitud debía estar abierta y, en el mismo
    // paso, queda "assigned" apuntando a ESTE pedido y a ESTE proveedor.
    // Así es imposible que dos proveedores se queden con la misma solicitud.
    function orderFromMyOffer(d, orderId) {
      return 'requestId' in d
        && get(/databases/$(database)/documents/requests/$(d.requestId)).data.customerId == me()
        && get(/databases/$(database)/documents/requests/$(d.requestId)).data.status == 'open'
        && exists(/databases/$(database)/documents/requests/$(d.requestId)/offers/$(d.providerId))
        && getAfter(/databases/$(database)/documents/requests/$(d.requestId)).data.status == 'assigned'
        && getAfter(/databases/$(database)/documents/requests/$(d.requestId)).data.orderId == orderId
        && getAfter(/databases/$(database)/documents/requests/$(d.requestId)).data.chosenProviderId == d.providerId;
    }

    // Fotos de evidencia del pedido (Storage: evidence/{orderId}/{tipo}-{número}.jpg).
    function validEvidence(p, orderId, kind) {
      return p is string && p.matches('evidence/' + orderId + '/' + kind + '-[0-9]{6,20}[.](jpg|jpeg|png|webp|heic|heif)');
    }

    function providerOrderUpdate(orderId) {
      let d = request.resource.data;
      let old = resource.data;
      return old.providerId == me()
        && changedKeys().hasOnly(['status', 'statusChangedAt', 'updatedAt', 'providerPhone', 'cancelReason', 'finalPrice', 'commissionPct', 'commissionIvaPct', 'serviceFee', 'amountDue', 'transferInfo', 'deliveredBy', 'weightPhotoPath', 'pickupPhotoPath', 'deliveryPhotoPath', 'deliveryVerified'])
        && old.status in providerNext()
        && d.status in providerNext()[old.status]
        && d.statusChangedAt == request.time
        && optStr(d, 'providerPhone', 20)
        && optStr(d, 'cancelReason', 300)
        // Al recibir y pesar la ropa (→ in_progress) el socio puede anotar el total a pagar.
        // Con foto OBLIGATORIA de la báscula (y opcional de la bolsa al recolectar).
        // (Con el servidor apagado la foto es opcional.)
        && (!changedKeys().hasAny(['amountDue']) || (d.status == 'in_progress' && validAmount(d.amountDue) && (!serverOn() || validEvidence(d.weightPhotoPath, orderId, 'weight'))))
        && (!changedKeys().hasAny(['weightPhotoPath', 'pickupPhotoPath']) || d.status == 'in_progress')
        && (!('weightPhotoPath' in changedKeys()) || validEvidence(d.weightPhotoPath, orderId, 'weight'))
        && (!('pickupPhotoPath' in changedKeys()) || validEvidence(d.pickupPhotoPath, orderId, 'pickup'))
        // …y sus datos para recibir transferencias (los ve solo el cliente de ESTE pedido).
        && (!changedKeys().hasAny(['transferInfo']) || (d.status == 'in_progress' && validTransferInfo(d.transferInfo)))
        // Al ENTREGAR queda fijo el total y el % de comisión vigente.
        // Si ya había total a pagar (el que vio y pagó el cliente), el total es ESE:
        // el socio no lo puede bajar al entregar.
        // En cualquier otro paso no se puede tocar ni el total ni el %.
        && (d.status == 'delivered'
              ? (isPrice(d.finalPrice) && d.finalPrice > 0 && d.commissionPct == currentCommissionPct()
                  && d.commissionIvaPct == currentIvaPct()
                  && (!('amountDue' in old) || d.finalPrice == old.amountDue)
                  && (!('deliveredBy' in d) || d.deliveredBy == 'provider')
                  // Entregar directo (sin PIN) exige FOTO de la entrega y queda para revisión.
                  // Con PIN, la entrega la registra el servidor (función entregarConPin).
                  // (Con el servidor apagado no hay PIN: se entrega directo, sin foto.)
                  && (serverOn()
                        ? (d.deliveryVerified == 'photo' && validEvidence(d.deliveryPhotoPath, orderId, 'delivery'))
                        : !changedKeys().hasAny(['deliveryVerified', 'deliveryPhotoPath']))
                  // Pagado con tarjeta: total = lo pagado y la cuota ya la fijó el servidor.
                  // En efectivo: el socio cobró también la cuota vigente (se suma a su adeudo).
                  && (old.get('paymentStatus', 'pending') == 'paid'
                        ? (d.finalPrice == old.amountDue && !changedKeys().hasAny(['serviceFee']))
                        : d.serviceFee == currentServiceFee()))
              : !changedKeys().hasAny(['finalPrice', 'commissionPct', 'commissionIvaPct', 'serviceFee', 'deliveryPhotoPath', 'deliveryVerified']));
    }

    function validAmount(v) { return isPrice(v) && v > 0; }

    // Cuenta del socio para que el cliente le transfiera DIRECTO (BÜBÜ no toca ese dinero).
    function validTransferInfo(m) {
      return m is map
        && m.keys().hasOnly(['holder', 'bank', 'account', 'note'])
        && isStr(m.holder, 2, 80)
        && optStr(m, 'bank', 40)
        && isStr(m.account, 6, 40)
        && optStr(m, 'note', 100);
    }

    // El socio corrige el total a pagar mientras el cliente NO haya pagado con tarjeta.
    function providerAmountUpdate(orderId) {
      let old = resource.data;
      return old.providerId == me()
        && old.status in ['in_progress', 'ready']
        && changedKeys().hasOnly(['amountDue', 'transferInfo', 'weightPhotoPath', 'updatedAt'])
        && !(old.get('paymentStatus', 'pending') in ['paid', 'review', 'transfer_ok'])
        && validAmount(request.resource.data.amountDue)
        && (!changedKeys().hasAny(['transferInfo']) || validTransferInfo(request.resource.data.transferInfo))
        // Total nuevo sin foto de báscula previa → la pide.
        && ('weightPhotoPath' in changedKeys()
              ? validEvidence(request.resource.data.weightPhotoPath, orderId, 'weight')
              : (!serverOn() || 'weightPhotoPath' in old));
    }

    // El socio confirma que SÍ le llegó la transferencia del cliente.
    function providerConfirmTransfer() {
      let old = resource.data;
      return old.providerId == me()
        && old.status in ['in_progress', 'ready', 'delivered']
        && old.get('paymentStatus', 'pending') == 'transfer'
        && changedKeys().hasOnly(['paymentStatus', 'updatedAt'])
        && request.resource.data.paymentStatus == 'transfer_ok';
    }

    // El cliente elige: aún no decide / tarjeta ('pending'), efectivo ('cash') o transferencia al socio ('transfer').
    // Nadie desde la app puede marcar 'paid': eso lo hace el servidor al confirmar
    // el pago con Stripe.
    // Al elegir transferencia puede reportar "Ya transferí": clave de rastreo y foto del
    // comprobante (la foto vive en Storage, en receipts/{orderId}/…).
    function customerPaymentChoice(orderId) {
      let old = resource.data;
      let d = request.resource.data;
      return old.customerId == me()
        && old.status in ['in_progress', 'ready', 'delivered']
        && changedKeys().hasOnly(['paymentStatus', 'updatedAt', 'transferRef', 'receiptPath', 'transferReportedAt'])
        && old.get('paymentStatus', 'pending') in ['pending', 'cash', 'transfer']
        && d.paymentStatus in ['pending', 'cash', 'transfer']
        // Ya entregado: solo puede reportar su transferencia, no cambiar de forma de pago.
        && (old.status != 'delivered' || d.paymentStatus == 'transfer')
        && (!changedKeys().hasAny(['transferRef', 'receiptPath', 'transferReportedAt'])
            || (d.paymentStatus == 'transfer'
                && optStr(d, 'transferRef', 40)
                && (!('receiptPath' in d) || (d.receiptPath is string && d.receiptPath.matches('receipts/' + orderId + '/[A-Za-z0-9_.-]{1,80}')))
                && d.transferReportedAt == request.time));
    }

    // "Ya recibí mi ropa": el cliente cierra el pedido si el socio no lo hizo.
    // El total es el que el cliente vio (amountDue) y el % lo pone el sistema.
    function customerDeliver() {
      let old = resource.data;
      let d = request.resource.data;
      return old.customerId == me()
        && old.status in ['in_progress', 'ready']
        && 'amountDue' in old
        && changedKeys().hasOnly(['status', 'statusChangedAt', 'updatedAt', 'finalPrice', 'commissionPct', 'commissionIvaPct', 'serviceFee', 'deliveredBy'])
        && d.status == 'delivered'
        && d.statusChangedAt == request.time
        && d.finalPrice == old.amountDue
        && d.commissionPct == currentCommissionPct()
        && d.commissionIvaPct == currentIvaPct()
        && (old.get('paymentStatus', 'pending') == 'paid' ? !changedKeys().hasAny(['serviceFee']) : d.serviceFee == currentServiceFee())
        && d.deliveredBy == 'customer';
    }

    function customerOrderUpdate() {
      let d = request.resource.data;
      let old = resource.data;
      return old.customerId == me()
        && changedKeys().hasOnly(['status', 'statusChangedAt', 'updatedAt', 'cancelReason'])
        && old.status in customerNext()
        && d.status in customerNext()[old.status]
        && d.statusChangedAt == request.time
        && optStr(d, 'cancelReason', 300);
    }

    function adminOrderUpdate() {
      return isAdmin()
        && changedKeys().hasOnly(['status', 'statusChangedAt', 'updatedAt', 'adminNote', 'finalPrice', 'commissionPct', 'commissionIvaPct', 'serviceFee', 'paymentStatus', 'deliveryReviewed'])
        && request.resource.data.status in allStatuses()
        // El equipo marca como revisada una entrega hecha con foto (sin PIN).
        && (!changedKeys().hasAny(['deliveryReviewed']) || request.resource.data.deliveryReviewed is bool)
        && optStr(request.resource.data, 'adminNote', 500)
        // Resolver pagos (p. ej. reembolso hecho en Stripe, o pago en revisión).
        && (!changedKeys().hasAny(['paymentStatus'])
            || request.resource.data.paymentStatus in ['pending', 'cash', 'transfer', 'transfer_ok', 'paid', 'review', 'refunded'])
        // El admin puede corregir el total o el % solo en pedidos entregados.
        && (!changedKeys().hasAny(['finalPrice', 'commissionPct', 'commissionIvaPct', 'serviceFee'])
            || (request.resource.data.status == 'delivered'
                && isPrice(request.resource.data.finalPrice)
                && validCommissionPct(request.resource.data.commissionPct)
                && validIvaPct(request.resource.data.get('commissionIvaPct', 0))
                && isPrice(request.resource.data.get('serviceFee', 0))));
    }

    match /orders/{orderId} {
      allow get, list: if signedIn() && (resource.data.customerId == me() || resource.data.providerId == me() || isAdmin());
      allow create: if isActiveUser() && validOrderCreate(request.resource.data, orderId);
      allow update: if signedIn() && (providerOrderUpdate(orderId) || providerAmountUpdate(orderId) || providerConfirmTransfer() || customerOrderUpdate() || customerPaymentChoice(orderId) || customerDeliver() || adminOrderUpdate());
      allow delete: if false;

      // ───── Chat del pedido (cliente ↔ socio) ─────
      // Cada pedido tiene su propia conversación. El cliente y el socio la ven SOLO
      // mientras el pedido está activo (y 48 h después de entregado); luego desaparece
      // para ellos y no se ve en otros pedidos. El admin la puede leer siempre para
      // revisar. Nadie puede editar ni borrar mensajes.
      function chatOrder() { return get(/databases/$(database)/documents/orders/$(orderId)).data; }
      function chatParticipant() { return signedIn() && (chatOrder().customerId == me() || chatOrder().providerId == me()); }
      function chatOpen() {
        let o = chatOrder();
        return o.status in ['requested', 'accepted', 'in_progress', 'ready']
          || (o.status == 'delivered' && o.get('statusChangedAt', request.time) > request.time - duration.value(48, 'h'));
      }
      match /messages/{messageId} {
        allow read: if isAdmin() || (chatParticipant() && chatOpen());
        allow create: if chatParticipant() && chatOpen()
          && request.resource.data.keys().hasOnly(['senderId', 'senderRole', 'text', 'createdAt'])
          && request.resource.data.senderId == me()
          && request.resource.data.senderRole == (chatOrder().customerId == me() ? 'customer' : 'provider')
          && isStr(request.resource.data.text, 1, 1000)
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    // ───────────── Calificaciones (id = id del pedido → una por pedido) ─────────────
    // Solo el cliente del pedido, y solo cuando está "delivered". No se editan.
    // El admin solo puede ocultarlas o mostrarlas.
    function reviewOrder(orderId) {
      return get(/databases/$(database)/documents/orders/$(orderId)).data;
    }

    function validReviewCreate(d, orderId) {
      return d.keys().hasOnly(['orderId', 'providerId', 'customerId', 'customerName', 'categoryId', 'stars', 'comment', 'hidden', 'createdAt'])
        && d.keys().hasAll(['orderId', 'providerId', 'customerId', 'stars', 'hidden', 'createdAt'])
        && d.orderId == orderId
        && d.customerId == me()
        && exists(/databases/$(database)/documents/orders/$(orderId))
        && reviewOrder(orderId).customerId == me()
        && reviewOrder(orderId).status == 'delivered'
        && d.providerId == reviewOrder(orderId).providerId
        && d.stars is int && d.stars >= 1 && d.stars <= 5
        && optStr(d, 'comment', 300)
        && optStr(d, 'customerName', 40)
        && optStr(d, 'categoryId', 60)
        && d.hidden == false
        && d.createdAt == request.time;
    }

    match /reviews/{orderId} {
      // get: también se permite consultar una reseña que aún no existe (para saber si ya calificaste).
      allow get: if signedIn() && (resource == null || resource.data.hidden == false
        || resource.data.customerId == me() || resource.data.providerId == me() || isAdmin());
      allow list: if signedIn() && (resource.data.hidden == false || resource.data.providerId == me() || isAdmin());
      allow create: if isActiveUser() && validReviewCreate(request.resource.data, orderId);
      allow update: if isAdmin()
        && changedKeys().hasOnly(['hidden', 'hiddenNote', 'hiddenBy', 'hiddenAt'])
        && request.resource.data.hidden is bool
        && optStr(request.resource.data, 'hiddenNote', 300)
        && (!('hiddenBy' in changedKeys()) || request.resource.data.hiddenBy == me());
      allow delete: if false;
    }

    // ───────────── Configuración general (solo admin escribe) ─────────────
    match /config/{docId} {
      allow get: if signedIn();
      allow list: if isAdmin();
      // pct: % de comisión · ivaPct: IVA sobre la comisión · serviceFee: cuota de servicio
      // que paga el cliente con tarjeta (pesos) · debtLimit: adeudo máximo antes de bloquear.
      allow create, update: if isSuperAdmin() && docId == 'commission'
        && request.resource.data.keys().hasOnly(['pct', 'ivaPct', 'serviceFee', 'debtLimit', 'cardEnabled', 'serverOn', 'updatedAt', 'updatedBy'])
        && (!('cardEnabled' in request.resource.data) || request.resource.data.cardEnabled is bool)
        && (!('serverOn' in request.resource.data) || request.resource.data.serverOn is bool)
        && validCommissionPct(request.resource.data.pct)
        && validIvaPct(request.resource.data.ivaPct)
        && isPrice(request.resource.data.serviceFee) && request.resource.data.serviceFee <= 200
        && isPrice(request.resource.data.debtLimit)
        && request.resource.data.updatedBy == me()
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // ───────────── Pagos de comisión que hacen los socios a BÜBÜ ─────────────
    // Los registra el admin cuando el socio le paga (transferencia, efectivo…).
    // El socio solo ve los suyos. No se editan; si se capturó mal, se borra
    // (y queda registrado en la bitácora) y se captura de nuevo.
    match /commissionPayments/{paymentId} {
      allow get, list: if signedIn() && (resource.data.providerId == me() || isAdmin());
      allow create: if isSuperAdmin()
        && request.resource.data.keys().hasOnly(['providerId', 'providerName', 'amount', 'method', 'note', 'createdAt', 'createdBy'])
        && request.resource.data.keys().hasAll(['providerId', 'amount', 'createdAt', 'createdBy'])
        && isStr(request.resource.data.providerId, 1, 128)
        && optStr(request.resource.data, 'providerName', 80)
        && request.resource.data.amount is number
        && request.resource.data.amount > 0 && request.resource.data.amount <= 1000000
        && optStr(request.resource.data, 'method', 40)
        && optStr(request.resource.data, 'note', 300)
        && request.resource.data.createdBy == me()
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    // ───────────── Pagos semanales de BÜBÜ a los socios (corte) ─────────────
    // Lo que BÜBÜ le transfiere al socio por pedidos pagados con tarjeta,
    // ya sin comisión. Los registra el admin; el socio solo ve los suyos.
    match /payouts/{payoutId} {
      allow get, list: if signedIn() && (resource.data.providerId == me() || isAdmin());
      allow create: if isSuperAdmin()
        && request.resource.data.keys().hasOnly(['providerId', 'providerName', 'amount', 'method', 'period', 'note', 'createdAt', 'createdBy'])
        && request.resource.data.keys().hasAll(['providerId', 'amount', 'createdAt', 'createdBy'])
        && isStr(request.resource.data.providerId, 1, 128)
        && optStr(request.resource.data, 'providerName', 80)
        && request.resource.data.amount is number
        && request.resource.data.amount > 0 && request.resource.data.amount <= 1000000
        && optStr(request.resource.data, 'method', 40)
        && optStr(request.resource.data, 'period', 60)
        && optStr(request.resource.data, 'note', 300)
        && request.resource.data.createdBy == me()
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    // ───────────── Cuenta del socio para recibir transferencias (id = UID) ─────────────
    // Solo él y el admin la ven aquí. Al cliente le llega copiada dentro de SU pedido.
    match /providerPayInfo/{providerId} {
      allow get: if signedIn() && (me() == providerId || isAdmin());
      allow list: if isAdmin();
      allow create, update: if signedIn() && me() == providerId
        && request.resource.data.keys().hasOnly(['holder', 'bank', 'account', 'note', 'updatedAt'])
        && isStr(request.resource.data.holder, 2, 80)
        && optStr(request.resource.data, 'bank', 40)
        && isStr(request.resource.data.account, 6, 40)
        && optStr(request.resource.data, 'note', 100)
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && me() == providerId;
    }

    // ───────────── PIN de entrega (lo crea el servidor; SOLO el cliente lo ve) ─────────────
    // El socio nunca lo puede leer: lo escribe al entregar y el servidor lo revisa
    // (máximo 5 intentos).
    match /deliveryPins/{orderId} {
      allow get: if signedIn() && (resource.data.customerId == me() || isAdmin());
      allow list: if false;
      allow write: if false;
    }

    // ───────────── Saldo del socio (lo calcula y escribe SOLO el servidor) ─────────────
    match /providerBalances/{providerId} {
      allow get: if signedIn() && (me() == providerId || isAdmin());
      allow list: if isAdmin();
      allow write: if false;
    }
    match /debtBlocks/{providerId} {
      allow get: if signedIn() && (me() == providerId || isAdmin());
      allow list: if isAdmin();
      allow write: if false;
    }

    // ───────────── Avisos al teléfono (id = UID) ─────────────
    // Cada quien guarda o borra SOLO el token de notificaciones de su teléfono.
    // Nadie más lo puede leer ni listar: lo usa el servidor (Cloud Functions),
    // que no pasa por estas reglas.
    match /pushTokens/{userId} {
      allow get: if signedIn() && me() == userId;
      allow list: if false;
      allow create, update: if signedIn() && me() == userId
        && request.resource.data.keys().hasOnly(['token', 'platform', 'app', 'updatedAt'])
        && isStr(request.resource.data.token, 20, 200)
        && request.resource.data.token.matches('Expo(nent)?PushToken.+')
        && request.resource.data.platform in ['android', 'ios']
        && optStr(request.resource.data, 'app', 20)
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && me() == userId;
    }

    // ───────────── Bitácora administrativa (solo agregar) ─────────────
    match /auditLog/{entryId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['adminId', 'action', 'targetType', 'targetId', 'details', 'createdAt'])
        && request.resource.data.adminId == me()
        && isStr(request.resource.data.action, 1, 60)
        && isStr(request.resource.data.targetType, 1, 40)
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
