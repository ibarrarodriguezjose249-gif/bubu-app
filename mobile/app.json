{
  "expo": {
    "name": "BÜBÜ",
    "slug": "bubu-servicios",
    "scheme": "bubu",
    "version": "0.4.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0066FF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.joseibarra.bubu",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.joseibarra.bubu",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0066FF"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "BÜBÜ",
      "shortName": "BÜBÜ",
      "themeColor": "#0066FF",
      "backgroundColor": "#FFFFFF",
      "favicon": "./assets/favicon.png"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/46983f8f-ae6c-4e8e-a411-c67c03ad6ee4",
      "requestHeaders": {
        "expo-channel-name": "preview"
      },
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "eas": {
        "projectId": "46983f8f-ae6c-4e8e-a411-c67c03ad6ee4"
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0066FF",
          "defaultChannel": "pedidos"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "BÜBÜ usa tus fotos solo para adjuntar el comprobante de tu transferencia o la foto de la bolsa del pedido.",
          "cameraPermission": "BÜBÜ usa la cámara solo para tomar la foto de la bolsa cerrada del pedido (báscula, recolección y entrega).",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "BÜBÜ usa tu ubicación para encontrar lavanderías cerca de ti y saber si hay servicio en tu zona."
        }
      ]
    ]
  }
}
